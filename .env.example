# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@host:5432/database

# Better Auth - base URL for OAuth callbacks
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob Storage (optional - falls back to local uploads in development)
BLOB_READ_WRITE_TOKEN=

# OAuth Providers (configure at least one)
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Vercel: https://vercel.com/account/oauth
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# Rate Limiting (optional)
DAILY_GENERATION_LIMIT=10

# Comma-separated user IDs with unlimited generations (optional)
UNLIMITED_USER_IDS=
